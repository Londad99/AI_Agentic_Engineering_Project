# Template. On first run the project copies this to .env automatically;
# fill in the value below there, not here. .env is git-ignored — this file is not.

# Required. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Models (defaults are fine)
GEMINI_MODEL=gemini-flash-latest
# gemini-embedding-2 is the current model (April 2026); -001 is legacy but supported
# until 2028. Run scripts/bench_embed.py to see which one is faster on your key,
# then re-ingest with --reset, since vectors from different models are not comparable.
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Texts per embedding request. Latency is dominated by the round trip, so larger
# batches cut ingestion time almost linearly. Lower it if large batches get rejected.
EMBED_BATCH_SIZE=100

# Hard ceiling on one API call, in seconds. Without it a stalled request hangs the
# notebook with no end; failing lets the retry loop below take over.
REQUEST_TIMEOUT_SECONDS=60

# Retry policy. A 503 "high demand" from Gemini is routine on the free tier, so the
# waits are sized for a capacity spike: 2, 4, 8, 16s (capped), ~30s of total patience.
# Raise RETRY_ATTEMPTS if your demo slot is at a busy hour.
RETRY_ATTEMPTS=5
RETRY_BASE_DELAY=2
RETRY_MAX_DELAY=16

# Chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Which provider answers.
#   auto   - Gemini, degrading to Ollama only if ENABLE_LOCAL_FALLBACK=true
#   gemini - Gemini only
#   ollama - local only; no Gemini call is attempted at all
# Use "ollama" when the daily Gemini quota is spent: the free tier allows 20 requests
# per day PER MODEL, so switching GEMINI_MODEL also buys a fresh budget.
LLM_PROVIDER=auto

# Embeddings provider. Switching this invalidates the vector store (vectors from
# different models are not comparable) - rebuild with: python scripts/ingest.py --reset
EMBED_PROVIDER=gemini
OLLAMA_EMBED_MODEL=nomic-embed-text

# Local fallback. Off while building: an 8B model on CPU is slow and gets in the way
# of debugging. Set to true before the live demo so a Gemini quota limit or a 503
# does not kill it. Requires `ollama serve` and `ollama pull qwen3:8b`.
ENABLE_LOCAL_FALLBACK=false
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
